accumulate "Trocq.Elpi/aterm-type".
accumulate "Trocq.Elpi/util".
accumulate "Trocq.Elpi/util-rocq".
accumulate "Trocq.Elpi/param-class-util".
accumulate "Trocq.Elpi/data".

% `@pi-adecl N AT (ax\ x\ x'\ xr\ F x x' xr)` declares elpi pi-variables x x' xr with adecl
% x has annotated type AT
macro @pi-adecl N PAD_AT PAD_F :-
  aterm.triple PAD_AT PAD_T PAD_T' PAD_TR,
  coq.name-suffix N "'" N',
  coq.name-suffix N "R" NR,
  @pi-decl N PAD_T x\ (
  @pi-decl N' PAD_T' x'\ (
  util.mk-app PAD_TR [x, x'] (PAD_TRx x x'),
  @pi-decl NR (PAD_TRx x x') xR\ (
  pi ax\ [
    adecl ax N x x' xR PAD_AT
  ] => (
    logging.trace (coq.say "[adecl]" ax "==" x "@" PAD_AT "~" x' "∵" xR),
    (PAD_F ax x x' xR)
  )))).

%XXX Enlever cette infamie parce que weakening appelle deux fois @pi-adec
macro @pi-adecl2 N POD_AT POD_F :-
  aterm.triple POD_AT POD_T POD_T' POD_TR,
  coq.name-suffix N "'" N',
  coq.name-suffix N "R" NR,
  @pi-decl N POD_T x\ (
  @pi-decl N' POD_T' x'\ (
  util.mk-app POD_TR [x, x'] (POD_TRx x x'),
  @pi-decl NR (POD_TRx x x') xR\ (
  pi ax\ [
    adecl ax N x x' xR POD_AT
  ] => (
    logging.trace (coq.say "[adecl]" ax "==" x "@" POD_AT "~" x' "∵" xR),
    (POD_F ax x x' xR)
  )))).

% curry f := fun x => f (fst x) (snd x)
% forall z : A * A', B[z] -> forall x : A, forall y : A', B[x,y]
% TODO XXX Move this back to data.elpi
func trocq.data.r param-class -> term.
trocq.data.r C T :-
  param-class.suspend-on C (
      trocq.db.r C Const, !,
      coq.env.global (const Const) T
  ).
func trocq.data.rel param-class -> term.
trocq.data.rel C T :-
  param-class.suspend-on C (
      trocq.db.rel C Const _ _ _ _, !,
      coq.env.global Const T
  ).

namespace annot {
  func weakener aterm, aterm -> term.
  weakener (asort _ C) (asort _ C') Weakener :- !,
    trocq.data.forget C C' Weakener.
  %TODO XXX We do not type the output function, as we have pi variable dependency issues appearing with this.
  % We should do more pruning because this should work in the future
  weakener (aprod N A P as AP) (aprod _ B Q as _BQ)
      (fun _ _ t\ fun _ _ t'\ fun _ _ tr\ fun _ _ x\ fun _ _ x'\ fun _ _ xr\ 
      %(fun _ TAP t\ fun _ TAP' t'\ fun _ RRTAP tr\ fun _ TB x\ fun _ TB' x'\ fun _ RRTB xr\ 
        WeakenerF t t' tr x x' xr) :- !,
    %aterm.triple AP TAP TAP' RTAP,
    %aterm.triple BQ TB TB' RTB, % Property on subtype, we should have TA=TB and TA'=TB'
    %util.mk-app RTAP [TAP,TAP'] RRTAP,
    %util.mk-app RTB [TB,TB'] RRTB,
    weakener B A BAWeakener,
    @pi-adecl `t` AP (_\ t\ t'\ tr\
    @pi-adecl2 N B (ax\ x\ x'\ xr\
    sigma XRWeakened TRWeakened PQWeakener\ (
      weakener (P ax) (Q ax) PQWeakener,
      util.mk-app BAWeakener [x,x',xr] XRWeakened,
      util.mk-app tr [x,x',XRWeakened] TRWeakened,
      util.mk-app PQWeakener [app [t, x],app [t', x'],TRWeakened] (WeakenerF t t' tr x x' xr)
    ))).
  weakener (aapp [ (afun _ _ AF),AX1|AXs]) (aapp [(afun _ _ AF'),AX1'|AXs']) W :- !,
    % We beta-reduce
    weakener (aapp [(AF AX1) | AXs]) (aapp [(AF' AX1') | AXs']) W.
  weakener (aapp [(uvar as XH)|_] as X) Y W :- declare_constraint (weakener X Y W) [XH], !.
  weakener (aapp [X|_] as T) (aapp [_|_]) W :- !,
    (name X ; X = aglobal _ _ _; X = apglobal _ _ _ _ ; trocq.error "[weakener] Input" T "is not a type"), !,
    % because sub-type T T', we have that eq AXs AXs', and as names and globals are not annotated, all annotations are the same
    W = fun _ _ t\ fun _ _ t'\ fun _ _ tr\ tr.
  weakener (uvar as X) Y W :- declare_constraint (weakener X Y W) [X], !.
  weakener X _ W :- (name X ; X = aglobal _ _ _ ; X = apglobal _ _ _ _ ), !,
    % names and globals are not annotated, so weakener is identity
    W = fun _ _ t\ fun _ _ t'\ fun _ _ tr\ tr.
  weakener X _ _ :- !,
    trocq.error "[weakener] Cannot weaken" X.


  % weaken A A' t t' tr tr' is ⇓^A_A' {t} {t'} tr = tr'
  pred weaken aterm, aterm, term, term, term -> term.
  weaken A B T T' TR TR' :- !,
    logging.trace (coq.say "[weaken] Weakening from" A "to" B "term" T "~" T' "∵" TR),
    prune W [], % Weakening does not depend on context
    weakener A B W,
    util.mk-app W [T,T',TR] TR'.
}

namespace aterm.util {
  % returns the weakest (resp. strongest) annotations for the given type
  func bottomOf atype -> atype.
  func topOf atype -> atype.
  bottomOf T U :- logging.trace (coq.say "[bottomOf]" T "//" U), fail, !.
  topOf T U :- logging.trace (coq.say "[topOf]" T "//" U), fail, !.
  bottomOf (asort S _) (asort S Bot) :- !, param-class.bottom Bot.
  topOf (asort S _) (asort S Top) :- !, param-class.top Top.
  bottomOf (aprod N AT AF) (aprod N AT' AF') :- !,
    topOf AT AT',
    @pi-adecl N AT' (ax\ _\ _\ _\
      % ax is also typed with AT because AT≤ AT'
      bottomOf (AF ax) (AF' ax)
    ), !.
  topOf (aprod N AT AF) (aprod N AT' AF') :- !,
    bottomOf AT AT',
    @pi-adecl N AT (ax\ _\ _\ _\
      % ax is also typed with AT' because AT'≤ AT
      topOf (AF ax) (AF' ax)
    ), !.
  bottomOf (aapp [ (afun _ _ AF),AX1|AXs]) Out :- !,
    % We beta-reduce
    bottomOf (aapp [(AF AX1) | AXs]) Out.
  topOf (aapp [ (afun _ _ AF),AX1|AXs]) Out :- !,
    % We beta-reduce
    topOf (aapp [(AF AX1) | AXs]) Out.
  bottomOf (aapp [(uvar as XH)|_] as X) X' :- declare_constraint (bottomOf X X') [XH], !.
  topOf (aapp [(uvar as XH)|_] as X) X' :- declare_constraint (topOf X X') [XH], !.
  % sub-type is isovariant on arguments of an app, so we need equality
  bottomOf (aapp [X|AXs] as T) (aapp [X'|AXs]) :- !,
    (name X ; X = aglobal _ _ _ ; X = apglobal _ _ _ _ ; trocq.error "[bottomOf] Input" T "is not a type"), !,
    bottomOf X X'.
  topOf (aapp [X|AXs] as T) (aapp [X'|AXs]) :- !,
    (name X ; X = aglobal _ _ _ ; X = apglobal _ _ _ _ ; trocq.error "[topOf] Input" T "is not a type"), !,
    topOf X X'.
  bottomOf X X :- !.
  topOf X X :- !.

  % Returns the raw parametry translation for the given type (set every annotation at 00)
  func rawOf atype -> atype.
  rawOf T U :- logging.trace (coq.say "[rawOf]" T "//" U), fail, !.
  rawOf (asort S _) (asort S Bot) :- !, param-class.bottom Bot.
  rawOf (aprod N AT AF) (aprod N AT' AF') :- !,
    rawOf AT AT',
    @pi-adecl N AT (ax\ _\ _\ _\
    @pi-adecl N AT' (ax'\ _\ _\ _\
      rawOf ax ax' =!=> rawOf (AF ax) (AF' ax')
    )), !.
  rawOf (aapp [ (afun _ _ AF),AX1|AXs]) Out :- !,
    % We beta-reduce
    rawOf (aapp [(AF AX1) | AXs]) Out.
  rawOf (aapp [(uvar as XH)|_] as X) X' :- declare_constraint (rawOf X X') [XH], !.
  rawOf (aapp [X|L] as T) (aapp [X'|L']) :- !,
    (name X ; X = aglobal _ _ _ ; X = apglobal _ _ _ _ ; trocq.error "[bottomOf] Input" T "is not a type"), !,
    rawOf X X',
    std.map L rawOf L'.
  rawOf X X :- !.
}

namespace aterm {

  func triple aterm -> term,term,term.
  triple AX X X' RX0 :- adecl AX _ X X' RX _,
    annot.weaken AX {aterm.util.bottomOf AX} X X' RX RX0, !.
  triple (atriple X X' RX) X X' RX.
  triple (asort S Cl) (sort S) (sort S) T :- 
    trocq.data.rel Cl T.
  triple (aglobal G TG' RG) (global G) TG' RG.
  triple (apglobal G U TG' RG) (pglobal G U) TG' RG.
  triple (afun N AT AF) (fun N T F) (fun N' T' F')
      (fun N T x\ fun N' T' x'\ fun NR TRx rx\ RF x x' rx) :-
    coq.name-suffix N "'" N', 
    coq.name-suffix N "R" NR, 
    triple AT T T' RT,
    util.mk-app RT [T,T'] TRx,
    @pi-adecl N AT (ay\ y\ y'\ ry\ triple (AF ay) (F y) (F' y') (RF y y' ry)).
  triple (aprod N AT AF) (prod N T F) (prod N' T' F')
      (fun `f` _ f\ fun `f'` _ f'\ prod N T x\ prod N' T' x'\ prod NR (TRx x x') rx\ RFOut f f' x x' rx) :-
    coq.name-suffix N "'" N', 
    coq.name-suffix N "R" NR, 
    triple AT T T' RT,
    @pi-adecl N AT (ay\ y\ y'\ ry\
      util.mk-app RT [y,y'] (TRx y y'),
      triple (AF ay) (F y) (F' y') (RF y y' ry),
      @pi-decl `f` _ f\   (
      @pi-decl `f'` _ f'\ ( sigma Fx Fx'\
        util.mk-app f [y] Fx,
        util.mk-app f' [y'] Fx',
        util.mk-app (RF y y' ry) [Fx, Fx'] (RFOut f f' y y' ry)
      ))
    ).
  triple (aapp AL) (app [X|L]) (app [X'|L']) Out :-
    util.mapTo3 AL triple [X|L] [X'|L'] [RX|RL],
    util.mk-app RX {util.interleave [L,L',RL]} Out.
  triple (uvar as AT) T T' RT :- !,
    declare_constraint (triple AT T T' RT) [AT].

  func erase aterm -> term.
  erase AT T :- triple AT T _ _.

  func tr aterm -> term.
  tr AT T' :- triple AT _ T' _.

  func rel aterm -> term.
  rel AT RT :- triple AT _ _ RT.

  % Annotates a term with fresh evars
  func fresh term -> aterm.
  fresh (sort S) (asort S Cl) :-
    prune Cl []. %XXX Check wether those prunes will cause any trouble.
  fresh (global G) (aglobal G G' RG) :-
    prune G' [],
    prune RG [].
  fresh (pglobal G U) (apglobal G U G' RG) :-
    prune G' [],
    prune RG [].
  fresh (fun Name T F) (afun Name AT AF) :- !,
    fresh T AT,
    pi y\ pi ay\ fresh y ay => fresh (F y) (AF ay).
  fresh (prod Name T F) (aprod Name AT AF) :- !,
    fresh T AT,
    pi y\ pi ay\ fresh y ay => fresh (F y) (AF ay).
  fresh (app L) (aapp AL) :- !,
    std.map L fresh AL.

  % TODO Implement the other constructors for all this section
}

func aterm.util.global i:aterm o:gref.
aterm.util.global (aglobal G _ _) G :- !.
aterm.util.global (apglobal G _ _ _) G :- !.
aterm.util.global (uvar as AT) G :-
  coq.env.global G T,
  (
    (T = global G, AT = aglobal G _ _);
    (T = pglobal G U, AT = apglobal G U _ _)
  ), !.

namespace aterm.util {
  %TODO XXX This method is weird, should it use pi-adecl ? Weird
  % Forgets the term annotations of a function aterm -> aterm
  func erase-fun name, atype, (aterm -> aterm) -> (term -> term).
  erase-fun N AT AF F :- !, 
    @pi-adecl N AT (ax\ x\ x'\ xr\
      aterm.triple (AF ax) (F x) _ _
    ).
  % {mk-app F Args} outputs a term corresponding to (aapp [F | Args])
  func mk-app aterm, list aterm -> aterm.
  mk-app T [] T :- !.
  mk-app (aapp L) XS (aapp L') :- !, std.append L XS L'.
  mk-app T XS (aapp [T|XS]) :- !.

  macro @pi-decl1 XXXXXN XXXXXT XXXXXF :- pi xxxxxx\ decl xxxxxx XXXXXN XXXXXT =!=> XXXXXF xxxxxx.
  % {mk-atriple A B R}  outputs an aterm AT such that aterm.triple AT A B R

  % Checks that term T is {weaken (_ -> _) {X} {X'} RX}
  %func extract-weaken term -> term, term, term.
  %extract-weaken (app [Forget,X,X',FRX]) X X' RX :-
  %  coq.env.global (const CForget) Forget,
  %  trocq.db.forget _ _ CForget, !, 
  %  extract-weaken FRX X X' RX.
  %extract-weaken RX _ _ RX.

  %func mk-atriple term,term,term -> aterm.
  %mk-atriple X X' RX AT :-
  %  logging.trace (coq.say "[mk-atriple] Making an atriple out of" "(" X "," X' "," RX ")" "->" AT), 
  %  fail, !.
  %mk-atriple (global G) B R (aglobal G B R) :- !.
  %mk-atriple (pglobal G U) B R (apglobal G U B R) :- !.
  %mk-atriple (sort S) (sort _) ParamMN (asort S C) :-
  %  coq.env.global (const ParamMNCst) ParamMN,
  %  trocq.db.r C ParamMNCst, !.
  %mk-atriple (fun N T F) (fun _ T' F')
  %    (fun _ T x\ fun _ T' x'\ fun _ TRx rx\ RF x x' rx) (afun N AT AF) :-
  %  util.split-app-last 2 TRx RT [T, T'],
  %  mk-atriple T T' RT AT,
  %  @pi-adecl N AT (ay\ y\ y'\ ry\ mk-atriple (F y) (F' y') (RF y y' ry) (AF ay)),
  %  !.
  %mk-atriple (prod N T F) (prod N' T' F')
  %    (fun _ FT f\ fun _ FT' f'\ prod _ T x\ prod _ T' x'\ prod _ (TRx x x') rx\ RFOut f f' x x' rx)
  %    (aprod N AT AF) :-
  %  sigma RT\ % RT should not depend on x nor on x'
  %  @pi-decl1 N T (x\ @pi-decl1 N' T' (x'\ util.split-app-last 2 (TRx x x') RT [x,x'])),
  %  mk-atriple T T' RT AT,
  %  @pi-adecl N AT (ay\ y\ y'\ ry\
  %    % RF should not depend on f nor on f'
  %    @pi-decl1 `f` FT f\ (
  %    @pi-decl1 `f'` FT' f'\ (
  %      util.split-app-last 2 (RFOut f f' y y' ry) (RF y y' ry) [app [f, y], app [f', y']]
  %    )),
  %    mk-atriple (F y) (F' y') (RF y y' ry) (AF ay)
  %  ),
  %  !.
  %mk-atriple (app [X|L]) (app [X'|L']) (app [RX|LLL]) (aapp [AX|AL]) :-
  %  mk-atriple X X' RX AX,
  %  util.mapBy3 LLL (x\ _\ _\ Out\ Out = x) L,
  %  util.mapBy3 LLL (_\ x'\ _\ Out\ Out = x') L',
  %  util.mapBy3 LLL mk-atriple AL, !.
  %mk-atriple X X' RX AX :- adecl AX _ X X' RX' AT,
  %  % This should rather check for convertibility rather than equality
  %  coq.unify-eq RX RX' ok,
  %  !.
  % Atriple (X Y, X' Y', R)
  %mk-atriple T T' (app [Rproj, R]) Out :-
  %  util.split-app-last 1 T X [Y],
  %  util.split-app-last 1 T' X' [Y'],
  %  coq.typecheck Y TY ok,
  %  coq.typecheck Y' TY' ok,
  %  extract-weaken R Y Y' RXYYRY,
  %  util.split-app-last 3 RXYYRY RX [Y, Y', RY],
  %  mk-atriple Y Y' RY AY,
  %  mk-atriple X X' RX AX, !,
  %  aterm.util.mk-app AX [AY] Out.
  
  % Second to last resort, if relation has a head gref, we try to δ-reduce it
  %mk-atriple T T' (app [H|Args]) AT :-
  %  coq.env.global (const GH) H,
  %  coq.env.const GH (some HB) _,
  %  util.mk-app HB Args R',
  %  coq.reduction.lazy.bi-norm R' R'',
  %  mk-atriple T T' R'' AT, !.
  
  % Last resort, we make a atriple
  %mk-atriple X X' RX AT :- 
  %  trocq.error "[mk-atriple] Could not make a non-generic atriple", !.
  % XXX Generic atriples are disabled for now
  %mk-atriple X X' RX (atriple X X' RX).

  % classes returns a list of all non-output param classes of an aterm and the _potential_ output param class
  % all-classes returns a list of all param-classes in an aterm (potential output included)
  func classes aterm -> list param-class, option param-class.
  func all-classes aterm -> list param-class.

  all-classes T Cz :-
    classes T Cs OC,
    if (OC = some C) (Cz = C :: Cs) (Cz = Cs).

  classes (uvar as X) L O :- !, declare_constraint (classes X L O) [X].
  classes (asort _ C) [] (some C) :- !.
  classes (aprod _ T F) Cs Out :- !,
    pi x\ (
      all-classes T LT,
      classes (F x) LF Out,
      std.append LT LF Cs
    ).
  classes (afun _ T F) Cs none :- !,
    pi x\ std.append {all-classes T} {all-classes (F x)} Cs.
  classes (aapp [F|Xs]) Cs Out :- !,
    std.flatten {std.map Xs all-classes} XCs,
    classes F FCs Out,
    std.append FCs XCs Cs.
  % The other cases are aglobal, apglobal, and (name X), which all leads to [],none
  classes _ [] none :- !.

  % Returns n,b where n is the number of input classes that T can hold, and
  % b is wether T has an output class
  func shape term -> int, bool.
  func shape.all term -> int.
  shape (sort _) 0 tt :- !.
  shape (prod _ T F) N B :- !,
    pi x\ (
      shape T TN TB,
      shape (F x) FN B,
      N is TN + FN + {util.bool->int TB}
    ).
  shape (fun _ T F) N ff :- !,
    pi x\ (
      shape T TN TB,
      shape (F x) FN FB,
      N is TN + FN + {util.bool->int TB} + {util.bool->int FB}
    ).
  shape (app [F|Xs]) N B :- !,
    std.fold Xs 0 (x\ n\ out\ sigma XN XB XBi\
      shape x XN XB,
      util.bool->int XB XBi,
      out is n + XN + XBi
    ) XsN,
    shape F FN B,
    N is FN + XsN.
  % The other cases are aglobal, apglobal, and (name X), which all leads to [],none
  %XXX This is bugged, see example Vector_tuple, Elpi fails on coq.env.global _ X when X is pglobal «append»
  %shape X 0 ff :- (coq.env.global _ X ; name X), !.
  shape X 0 ff :- (X = global _ ; X = pglobal _ _ ; name X), !.
  shape.all T N :- !, shape T NT B, N is NT + {util.bool->int B}.

  func fake-term->aterm term -> aterm.
  fake-term->aterm (app [PType|L]) (asort (typ U) Cl) :-
    trocq.data.ptype PType, !,
    L = [TM, TN],
    trocq.data.term->map-class TM M,
    trocq.data.term->map-class TN N,
    if (var M, var N)
    (Cl = _)
    (Cl = pc M N),
    coq.univ.new U.
  fake-term->aterm (app [PTriple|L]) Out :-
    trocq.data.ptriple PTriple,
    L = [_,_,_,X,X',RX|L'], !,
    std.map L' fake-term->aterm AL',
    % XXX Reactivate this, but think about it first
    %coq.elaborate-skeleton RX (prod `_` X _\ prod `_` X' _\ sort _) RXR Diag,
    %(Diag = ok, ! ; trocq.error {coq.term->string RX} "is not a relation between" {coq.term->string X} "and" {coq.term->string X'} Diag), !,
    RXR = RX,
    if (X = global G)
    (OutT = aglobal G X' RXR)
    (if (X = pglobal G U)
    (OutT = apglobal G U X' RXR)
    (OutT = atriple X X' RXR)),
    std.map L' fake-term->aterm AL',
    aterm.util.mk-app OutT AL' Out.
  fake-term->aterm (sort S) (asort S Cl) :- !,
    prune Cl []. %XXX Check wether those prunes will cause any trouble.
  fake-term->aterm (global G) (aglobal G G' RG) :- !,
    prune G' [],
    prune RG [].
  fake-term->aterm (pglobal G U) (apglobal G U G' RG) :- !,
    prune G' [],
    prune RG [].
  fake-term->aterm (fun Name T F) (afun Name AT AF) :- !,
    fake-term->aterm T AT,
    @pi-adecl Name AT (ay\ y\ _\ _\
      fake-term->aterm (F y) (AF ay)
    ).
  fake-term->aterm (prod Name T F) (aprod Name AT AF) :- !,
    fake-term->aterm T AT,
    @pi-adecl Name AT (ay\ y\ _\ _\ 
      fake-term->aterm (F y) (AF ay)
    ).
  fake-term->aterm (app L) (aapp AL) :- !,
    std.map L fake-term->aterm AL.
  fake-term->aterm X AX :- adecl AX _ X _ _ _, !.

  % From a full aterm in the database, instantiates a aterm with holes
  func equals-ignore aterm -> aterm.
  equals-ignore X X' :-
    logging.trace (coq.say "[equals-ignore]" X "vs" X'), fail, !.
  equals-ignore (aprod N AT F) (aprod _ AT' F') :- !,
    equals-ignore AT AT',
    @pi-adecl N AT (ax\ _\ _\ _\ equals-ignore (F ax) (F' ax)).
  equals-ignore (afun N AT F) (afun _ AT' F') :- !,
    equals-ignore AT AT',
    @pi-adecl N AT (ax\ _\ _\ _\ equals-ignore (F ax) (F' ax)).
  equals-ignore (atriple X Y RX) (atriple X' Y' RX') :- !,
    util.equals-ignore X X',
    util.equals-ignore Y Y',
    util.equals-ignore RX RX'.
  equals-ignore (asort _ Cl) (asort _ Cl) :- !.
  equals-ignore (aglobal G TG RG) (aglobal G TG' RG') :- !,
    util.equals-ignore TG TG',
    util.equals-ignore RG RG'.
  equals-ignore (apglobal G _ TG RG) (apglobal G _ TG' RG') :- !,
    util.equals-ignore TG TG',
    util.equals-ignore RG RG'.
  equals-ignore (aapp [X]) (aapp [X']) :- !,
    equals-ignore X X'.
  equals-ignore (aapp [X|L]) (aapp [X'|L']) :- !,
    equals-ignore X X',
    equals-ignore (aapp L) (aapp L').
  equals-ignore X X :- !.

  % remove head weakenings from the input term
  func remove-weakenings term -> term.
  remove-weakenings (app [Weakener,_,_,T]) T' :- 
    trocq.data.forget _ _ Weakener, !,
    remove-weakenings T T'.
  remove-weakenings T T.
}