digraph {

    # STYLE
    rankdir=TB; # Dependencies are from top to bottom

    ## ELPI FILES
    "class" [shape=box, URL="https://github.com/rocq-community/trocq/blob/master/elpi/class.elpi"];
    "util" [shape=box, URL="https://github.com/rocq-community/trocq/blob/master/elpi/util.elpi"];
    "logging" [shape=box, URL="https://github.com/rocq-community/trocq/blob/master/elpi/logging.elpi"];
    "util-rocq" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/util-rocq.elpi"];
    "database" [shape=box, URL="https://github.com/rocq-community/trocq/blob/master/elpi/database.elpi"];
    "aterm" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/aterm.elpi"];
    "fake-aterm" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/fake-aterm.elpi"];
    "aterm-type" [shape=box, URL="https://github.com/rocq-community/trocq/blob/master/elpi/aterm-type.elpi"];
    "c/constraints" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/constraints/constraints.elpi"];
    "constraints" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/constraints.elpi"];
    "coercion" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/coercion.elpi"];
    "c/simple-graph" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/constraints/simple-graph.elpi"];
    "c/constraint-graph" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/constraints/constraint-graph.elpi"];
    "c/constraints-impl" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/constraints/constraints-impl.elpi"];
    "annot" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/annot.elpi"];
    "data" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/data.elpi"];
    "param-class-util" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/param-class-util.elpi"];
    "param" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/param.elpi"];
    "tactic" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/tactic.elpi"];
    "vernac" [URL="https://github.com/rocq-community/trocq/blob/master/elpi/vernac.elpi"];

    ## DEPENDENCIES
    "util" -> {"database"};
    "logging" -> {"util-rocq"};
    "util-rocq" -> {"param-class-util"};
    "class" -> {"aterm-type"};
    "database" -> {"logging" "param-class-util"};
    "aterm" -> {"c/constraints" "fake-aterm"};
    "aterm-type" -> {"database"};
    "fake-aterm" -> {"vernac"}
    "constraints" -> "annot";
    "c/constraints" -> "c/simple-graph";
    "c/simple-graph" -> "c/constraint-graph";
    "c/constraint-graph" -> "c/constraints-impl";
    "c/constraints-impl" -> {"constraints"};
    "annot" -> {"vernac" "param"};
    "data" -> "aterm";
    "param-class-util" -> {"data"};
    "param" -> {"coercion" "tactic"};

    ## CLUSTERS
    subgraph cluster_trocqdb {
        label="trocq.db header";
        style=filled;
        fillcolor="#dffdc0";
        "class" "database" "util" "aterm-type";
    }
    subgraph cluster_constraints {
        labelloc="r";
        label="constraints";
        style=filled;
        fillcolor=lightyellow;
        URL="https://github.com/rocq-community/trocq/tree/master/elpi/constraints";
        "c/constraints" "c/simple-graph" "c/constraint-graph" "c/constraints-impl";
    }
}
